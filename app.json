{
  "expo": {
    "name": "CalculNotesISEN",
    "slug": "CalculNotesIsen",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/brand/icon.png",
    "scheme": "calculnotesisen",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anthony.coulais.CalculNotesIsen"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#26264C",
        "foregroundImage": "./assets/brand/android-foreground.png",
        "backgroundImage": "./assets/brand/android-background.png",
        "monochromeImage": "./assets/brand/android-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anthony.coulais.CalculNotesIsen"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#26264C",
          "dark": {
            "backgroundColor": "#26264C"
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "00c960d0-6c03-4be2-89b5-3c2dbf6c5e15"
      }
    }
  }
}
